# คัดลอกเป็น .env.local แล้วแก้ค่า (ไฟล์ .env.local ไม่ถูก commit)
# ดู AWS-SETUP.md หัวข้อ 14.2

# --- โหมด API จำลองในเครื่อง (Backend: python scripts/local_api.py) ---
VITE_API_URL=http://localhost:3001
VITE_AUTH_MODE=dev

